[Desktop Entry]
Type=Application
Name=Firn
GenericName=Web Browser
Comment=A calm, minimalist desktop browser
Exec=firn -- %U
Icon=firn
Terminal=false
StartupNotify=true
StartupWMClass=firn
Categories=Network;WebBrowser;
MimeType=x-scheme-handler/http;x-scheme-handler/https;text/html;application/xhtml+xml;application/pdf;image/svg+xml;image/webp;
Keywords=web;browser;internet;
