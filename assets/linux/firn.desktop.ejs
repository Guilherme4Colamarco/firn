[Desktop Entry]
Type=Application
Name=<%= productName %>
GenericName=<%= genericName %>
Comment=<%= description %>
Exec=<%= name %> -- %U
Icon=<%= name %>
Terminal=false
StartupNotify=true
StartupWMClass=<%= name %>
Categories=<%= categories.join(';') %>;
MimeType=<%= mimeType.join(';') %>;
Keywords=web;browser;internet;
